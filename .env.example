# انسخي هذا الملف باسم .env للتشغيل المحلي فقط — لا ترفعي .env على GitHub (مضاف في .gitignore).
# تنبيه: أي متغير يبدأ بـ VITE_ ينكتب داخل كود الموقع ويشوفه أي زائر، فلا تحطين فيه أي سر.
# البناء يوقف تلقائيًا لو لقى مفتاح سري في متغير يبدأ بـ VITE_.

# ─── عام (يظهر في الموقع) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# إيميل حساب الأدمن في Supabase Auth (كلمة المرور ما تنحط هنا أبدًا)
VITE_ADMIN_EMAIL=admin@example.com

# ─── سري (على السيرفر فقط — بدون VITE_) ───
SUPABASE_SERVICE_ROLE_KEY=
ZEPTOMAIL_TOKEN=
EMAIL_FROM_ADDRESS=info@cubex.com.sa
EMAIL_FROM_NAME=تَبصَّر
PUBLIC_SITE_URL=https://cubex.com.sa
# روابط إضافية مسموح لها تطلب إيميل التأكيد (مفصولة بفاصلة)، مثل نطاق الأمانة لاحقًا
ALLOWED_ORIGINS=
